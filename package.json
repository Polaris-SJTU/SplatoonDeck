{
  "name": "splatoon-deck",
  "version": "0.3.0",
  "private": true,
  "description": "Use keyboard and mouse with Switch 2, and draw imported images in Splatoon 3",
  "main": "electron/main.cjs",
  "author": "SplatoonDeck contributors",
  "license": "MIT",
  "scripts": {
    "build:native": "node scripts/build-native-helper.cjs",
    "dev": "npm run build:native && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "npm run build:native && tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder --win portable",
    "test": "npm run build:native && vitest run && node --test electron/system-manager.test.cjs"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vite": "latest",
    "typescript": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "concurrently": "latest",
    "wait-on": "latest",
    "vitest": "latest",
    "jsdom": "latest"
  },
  "build": {
    "appId": "ink.splatoondeck.desktop",
    "productName": "SplatoonDeck",
    "electronDist": ".cache/electron-dist",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist-ui/**/*",
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/splatoondeck_bridge.py",
        "to": "backend/splatoondeck_bridge.py"
      },
      {
        "from": "scripts/linux-setup.sh",
        "to": "scripts/linux-setup.sh"
      },
      {
        "from": "native/bin/SplatoonDeck.Setup.exe",
        "to": "native/SplatoonDeck.Setup.exe"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SplatoonDeck-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "SplatoonDeck-${version}-portable.exe",
      "requestExecutionLevel": "user"
    }
  }
}
